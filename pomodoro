#! /usr/bin/env bash

function sleepForMinutes(){
    seconds="$(("$1"*60))"
    while [ $seconds -gt 0 ]; do
        MIN=$(("$seconds" / 60))
        SEC=$(("$seconds" % 60))
        printf "%02d:%02d\033[0K\r" $MIN $SEC
       sleep 1
       : $((seconds--))
    done
}

